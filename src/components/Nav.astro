---
import site from '../data/site.json';
import nav from '../data/nav.json';
import { asset } from '../lib/asset';
import Spider from './Spider.astro';
---

<nav id="nav">
  <a href="#" class="logo">
    <img src={asset("/assets/images/logo-mark.webp")} alt="SIA Logo" class="logo-img" />
    <!-- Halloween: a witch hat worn on the S. A layer over the logo, not a new logo, so it comes
         off after the season without touching the artwork (nav.css places it) -->
    <svg class="logo-hat" viewBox="0 0 40 22" aria-hidden="true">
      <clipPath id="logo-hat-cone">
        <path id="logo-hat-cone-shape" d="M13 19.4C14.9 14.6 16.4 10.2 17.6 6.6C18.2 4.9 19.4 4 20.8 4.1C23.8 4.3 27.2 8.6 29.4 14.4C27.2 11.6 24.8 10.2 22.3 10C23.2 13.2 24.8 16.6 27 19.4Z" />
      </clipPath>
      <ellipse cx="20" cy="19.4" rx="18.5" ry="1.5" />
      <use href="#logo-hat-cone-shape" />
      <rect class="logo-hat-band" clip-path="url(#logo-hat-cone)" y="16.1" width="40" height="3.3" />
    </svg>
    <div class="logo-brand-group">
      <span class="logo-brand-name">{site.name}</span>
      <span class="logo-brand-tagline">{site.tagline}</span>
    </div>
  </a>
  <ul class="nav-links">
    {nav.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    <li class="nav-cta">
      <a href={site.bookingUrl} class="nav-book" target="_blank" rel="noopener">Book a Camp</a>
      <!-- hides behind the button, legs peeking out under it, and drops on its thread on
           hover (nav.css, driven by scripts/modules/nav-decor.js) -->
      <span class="nav-spider" aria-hidden="true">
        <span class="nav-spider-hang">
          <span class="nav-spider-thread"></span>
          <Spider class="nav-spider-svg" friendly />
        </span>
      </span>
    </li>
  </ul>
  <div class="nav-toggle" data-action="nav-toggle" role="button" tabindex="0" aria-label="Menu">
    <span></span><span></span><span></span>
  </div>
</nav>
<div class="mob-menu" id="mobmenu">
  {nav.links.map((link) => <a href={link.href} data-action="nav-close">{link.label}</a>)}
  <a href={site.bookingUrl} class="mob-book" data-action="nav-close" target="_blank" rel="noopener"
    >Book a Camp</a
  >
</div>
