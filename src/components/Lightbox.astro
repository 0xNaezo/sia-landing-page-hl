---
// Gallery lightbox. Driven by src/scripts/modules/gallery.js.
---

<div id="lightbox" data-action="lb-close">
  <button class="lb-close" type="button" data-action="lb-close" aria-label="Close">&#x2715;</button>
  <button class="lb-arrow lb-prev" type="button" data-action="lb-prev" aria-label="Previous photo"
    >&#8592;</button
  >
  <div id="lb-counter"></div>
  <div class="lb-img-wrap">
    <img id="lb-img" alt="" />
  </div>
  <button class="lb-arrow lb-next" type="button" data-action="lb-next" aria-label="Next photo"
    >&#8594;</button
  >
</div>
