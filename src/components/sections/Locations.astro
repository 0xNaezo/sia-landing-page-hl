---
import site from '../../data/site.json';
import locations from '../../data/locations.json';
import SectionHead from '../SectionHead.astro';
import Bat from '../Bat.astro';
const pins = ['a', 'b', 'c'];
---

<section class="sec sec-cream" id="locations">
  <div class="container">
    <SectionHead title="OUR LOCATIONS &amp; DATES" />

    <!-- Mobile map (shown only on small screens) -->
    <div class="mob-locations-map">
      <div class="mob-locations-map-inner">
        <iframe
          src={site.mapEmbedUrl}
          width="100%"
          height="145%"
          class="loc-map-frame"
          allowfullscreen
          loading="lazy"
          title="SIA Camp Locations"></iframe>
      </div>
    </div>

    <div class="loc-layout reveal">
      <div class="loc-map">
        <iframe
          src={site.mapEmbedUrl}
          width="100%"
          height="125%"
          class="loc-map-frame"
          allowfullscreen
          loading="lazy"
          title="SIA Camp Locations Dublin"></iframe>
      </div>
      <div class="loc-list">
        {
          locations.map((loc, i) => (
            <a class="loc-card" href={loc.mapUrl} target="_blank" rel="noopener">
              <svg class="loc-pin" aria-hidden="true"><use href={`#stl-pumpkin-${pins[i % pins.length]}`} /></svg>
              <div>
                <div class="loc-name">{loc.name}</div>
                <div class="loc-sub">{loc.area}</div>
                <div class="loc-meta">
                  <span class="loc-dates">{loc.dates}</span>
                  <span class="loc-time">{loc.time}</span>
                </div>
              </div>
              <span class="loc-open">Open Map →</span>
            </a>
          ))
        }
        <p class="loc-note">Click any location to open Google Maps</p>
      </div>
      <!-- decor: a moon low in the right column, under the cards, and a few bats flying off it
           up-left towards them (small/far first) -->
      <span class="loc-decor" aria-hidden="true">
        <span class="loc-moon"></span>
        <Bat class="loc-bat" />
        <Bat class="loc-bat" />
        <Bat class="loc-bat" />
        <Bat class="loc-bat" />
      </span>
    </div>
  </div>
</section>
