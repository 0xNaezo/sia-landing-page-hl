---
// Founder section. Prose lives here rather than in JSON: it is a single block of copy, not a list.
import { asset } from '../../lib/asset';
---

<section class="sec sec-cream" id="founder">
  <div class="container">
    <div class="found-grid">
      <div class="found-vis reveal">
        <div class="found-port mob-found-port">
          <img src={asset("/assets/images/founder-portrait.webp")} alt="Mark Kelly" class="found-photo" />
          <div class="found-lbl">· Founder ·</div>
          <div class="found-yrs">
            <span class="n">15+</span><span class="l">Years inspiring<br />young archaeologists</span>
          </div>
          <!-- Mobile quote overlay (mobile only, see mobile.css) -->
          <div class="mob-found-quote">
            <span class="mob-found-name">Our Founder — Mark Kelly</span>
            <p>
              History isn't locked in a textbook — it's tangible. When a child holds an artefact
              they uncovered, history becomes real.
            </p>
          </div>
        </div>
      </div>
      <div class="reveal d1 found-copy">
        <h2 class="sec-title">Mark Kelly</h2>
        <div class="found-name">Founder &amp; Director, School of Irish Archaeology</div>
        <div class="found-q">
          <p>
            At the School of Irish Archaeology, we believe that history isn't something meant to be
            locked away in a textbook — it is entirely tangible, a physical reality where children
            can actually reach out and touch the past.
          </p>
          <p>
            When you hand a child a trowel and they uncover an artefact hidden beneath the earth, a
            spark ignites. In that single, unforgettable moment, history becomes something they can
            hold in their hands.
          </p>
          <p>
            We aren't just giving children a fun few days of camp; we are offering a once-in-a-lifetime
            experience that leaves a deep, lasting memory they will carry with them into adulthood.
          </p>
        </div>
        <!-- Signature goes here (SVG of Mark's real signature + a small name line) once the client
             supplies it. Do not imitate one with a script font. -->
      </div>
    </div>
  </div>
</section>
