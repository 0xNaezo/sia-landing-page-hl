---
import site from '../../data/site.json';
import { asset } from '../../lib/asset';
---

<section class="sec sec-parchment" id="who">
  <!-- decor: tone-on-tone ghost pattern, kept to the margins by a CSS mask (who.css).
       The ghost is a flat silhouette with slit eyes cut out (evenodd). -->
  <svg class="who-pattern" aria-hidden="true">
    <defs>
      <symbol id="who-ghost" viewBox="0 0 58 80">
        <path
          fill-rule="evenodd"
          d="M29 3C16 3 8 14 8 30v42q7-9 14 0q7-9 14 0q7-9 14 0V30C50 14 42 3 29 3zM19 25q5.5 4 5 13q-5.5-4-5-13zM39 25q-5.5 4-5 13q5.5-4 5-13z"
        />
      </symbol>
      <!-- no patternTransform: a tile-wide rotation drifts rows upward as x grows and shears the
           right-hand ghosts out of the top band. Each ghost carries its own tilt instead. -->
      <pattern id="who-ghosts" width="400" height="400" patternUnits="userSpaceOnUse">
        <g fill="#3a2a12" fill-opacity=".07">
          <!-- scale(-1 1) mirrors about the translate point, so those ghosts grow leftwards from x -->
          <!-- top row starts at y=46 so nothing is sliced by the section's top edge -->
          <use href="#who-ghost" width="50" height="69" transform="translate(28 46) rotate(-6)" />
          <use href="#who-ghost" width="34" height="47" transform="translate(148 64) rotate(-4)" />
          <use href="#who-ghost" width="32" height="44" transform="translate(392 58) scale(-1 1) rotate(7)" />
          <use href="#who-ghost" width="38" height="52" transform="translate(268 96) scale(-1 1) rotate(-17)" />
          <use href="#who-ghost" width="36" height="50" transform="translate(300 196) rotate(9)" />
          <use href="#who-ghost" width="44" height="61" transform="translate(112 214) rotate(13)" />
          <use href="#who-ghost" width="30" height="41" transform="translate(374 292) scale(-1 1) rotate(3)" />
          <use href="#who-ghost" width="40" height="55" transform="translate(56 330) scale(-1 1) rotate(-13)" />
          <use href="#who-ghost" width="34" height="47" transform="translate(244 336) rotate(-10)" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#who-ghosts)" />
    <!-- one ghost parked over the word "First" in the heading: the copy column is inside the
         1200px container, so "First" sits a constant 305px right of centre at desktop widths -->
    <svg x="50%" y="0" overflow="visible" aria-hidden="true">
      <g fill="#3a2a12" fill-opacity=".07">
        <use href="#who-ghost" width="40" height="55" transform="translate(285 24) rotate(-8)" />
      </g>
    </svg>
    <!-- the tile alone is symmetric, so at wide viewports both margins get the same count.
         These extras are pinned to the right edge (nested svg at x=100%, children at negative x)
         to make the right margin read a little busier than the left. -->
    <svg x="100%" y="0" overflow="visible" aria-hidden="true">
      <g fill="#3a2a12" fill-opacity=".07">
        <use href="#who-ghost" width="36" height="50" transform="translate(-52 132) scale(-1 1) rotate(8)" />
        <use href="#who-ghost" width="28" height="39" transform="translate(-160 210) scale(-1 1) rotate(14)" />
        <use href="#who-ghost" width="30" height="41" transform="translate(-100 300) rotate(-11)" />
        <use href="#who-ghost" width="42" height="58" transform="translate(-46 430) scale(-1 1) rotate(-5)" />
      </g>
    </svg>
  </svg>

  <div class="container">
    <div class="who-grid">
      <div class="who-vis reveal mob-who-video">
        <div
          class="who-box who-video"
          data-action="video-open"
          data-video-src={site.videoEmbedUrl}
          role="button"
          tabindex="0"
          aria-label="Watch our story"
        >
          <img
            src={asset("/assets/images/team-photo.webp")}
            alt="SIA Team"
            class="who-video-img"
            width="3839"
            height="2159"
          />
          <div class="who-video-shade"></div>
          <div class="who-video-play">
            <div class="who-video-btn">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#C8751A" aria-hidden="true"
                ><polygon points="6,3 20,12 6,21"></polygon></svg
              >
            </div>
            <span class="who-video-label">Watch Our Story</span>
          </div>
        </div>
        <div class="who-float"><span class="n">2011</span><span class="l">Founded</span></div>
      </div>
      <div class="reveal d1 mob-who-text">
        <div class="sec-label">Who We Are</div>
        <h2 class="sec-title">Ireland's First<br />Archaeology School</h2>
        <div class="amber-bar"></div>
        <div class="who-text">
          <p>
            Imagine your child spending mid-term as a young archaeologist — trowel in hand, brushing
            soil from a real artefact, then shaping a witch's cauldron out of clay. That is what the
            SIA Halloween Camp is: active, hands-on learning that feels like a real adventure.
          </p>
          <p>
            Long before pumpkins and plastic costumes, Halloween was Samhain — and Ireland has been
            marking it for three thousand years. Over four days children dig, craft and step into
            that older story: the Cailleach, mummers' masks, Viking spears and lantern-lit folklore.
            Real history, real skills, and a mid-term they won't forget.
          </p>
        </div>
      </div>
    </div>
  </div>

</section>
