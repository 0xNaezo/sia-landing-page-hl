---
import stats from '../../data/stats.json';
import SectionHead from '../SectionHead.astro';
const delays = ['', 'd1', 'd2', 'd3'];
---

<section class="sec sec-dark" id="stats">
  <!-- decor: purple glow in the bottom-left corner, warm spot top-right -->
  <span class="stats-decor" aria-hidden="true">
    <span class="stats-glow"></span>
    <span class="stats-spot"></span>
  </span>
  <div class="container">
    <SectionHead title="SIA in Numbers" light bar={false} />
    <div class="stats-grid">
      {
        stats.map((stat, i) => (
          <div class:list={['stat', 'reveal', delays[i % delays.length]]}>
            {/* prettier-ignore: the "+" must hug the counter, no whitespace in between */}
            <div class="stat-num"><span class="counter" data-target={stat.value}>0</span>+</div>
            <div class="stat-lbl">{stat.label}</div>
            <div class="stat-desc">{stat.desc}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
