---
import site from '../../data/site.json';
---

<section class="hero" id="home">
  <div class="hero-photo"></div>
  <div class="hero-overlay"></div>
  <div class="hero-inner container">
    <div class="hero-left">
      <h1 class="hero-h1">
        <span class="hero-line">Archaeology</span><span class="hero-line">Summer Camp</span>
        <span class="hero-sub">For Curious Children Across Ireland</span>
      </h1>
      <p class="hero-p">
        <span class="hero-p-full"
          >Hands-on archaeology camps where children dig, discover artefacts, explore history, make
          friends and build confidence through unforgettable outdoor experiences.</span
        ><span class="hero-p-short"
          >Dig, discover, make friends &amp; build confidence — an unforgettable outdoor adventure.</span
        >
      </p>
      <div class="hero-btns">
        <a href={site.bookingUrl} class="btn-amber" id="hero-book-btn" target="_blank" rel="noopener"
          >Book a Camp</a
        >
      </div>
    </div>
  </div>
</section>
<div class="scroll-hint-outer">
  <div class="scroll-hint-inner">
    <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
  </div>
</div>
