---
import schedule from '../../data/schedule.json';
import SectionHead from '../SectionHead.astro';
import CornerWeb from '../CornerWeb.astro';
const variants = ['a', 'b', 'c'];
const tilts = [-8, 6, -4, 8, -6, 3, -7];
---

<section class="sec sec-parchment" id="schedule">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <radialGradient id="stl-lit" cx=".5" cy=".55" r=".6">
        <stop offset="0" stop-color="#ffe9a8" stop-opacity=".75" />
        <stop offset="1" stop-color="#ffe9a8" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="stl-face" cx=".5" cy=".5" r=".7">
        <stop offset="0" stop-color="#fff4c2" />
        <stop offset="1" stop-color="#ffcf5c" />
      </radialGradient>
    </defs>
    <!-- three jack-o'-lantern shapes: round grin, squat smile, tall surprised -->
    <symbol id="stl-pumpkin-a" viewBox="0 0 40 40">
      <path d="M17.6 11c-.6-3.2.3-5.9 2.6-8 1.6 2.2 2.1 4.9 1.5 8z" style="fill:#5b6b2e" />
      <ellipse cx="20" cy="24" rx="17" ry="13.5" style="fill:var(--amber-dark)" />
      <ellipse cx="20" cy="24" rx="11" ry="14" style="fill:var(--amber)" />
      <ellipse cx="20" cy="24" rx="5" ry="14.3" style="fill:var(--amber-light)" />
      <ellipse cx="20" cy="26" rx="14" ry="10" fill="url(#stl-lit)" />
      <path fill="url(#stl-face)" d="M10 23l4-6 3 6zM23 23l3-6 4 6zM18 26.5l2-3 2 3zM9 29h22l-2.5 4.2-2.7-2.6-3 3.4-2.8-3.2-2.8 3.2-3-3.4-2.7 2.6z" />
    </symbol>
    <symbol id="stl-pumpkin-b" viewBox="0 0 40 40">
      <path d="M17.8 13.5c-1.2-3 0-5.6 2.8-7.2 1.2 2.1 1.5 4.6.8 7.2z" style="fill:#5b6b2e" />
      <ellipse cx="20" cy="25.5" rx="18.5" ry="12.5" style="fill:var(--amber-dark)" />
      <ellipse cx="20" cy="25.5" rx="12.5" ry="13" style="fill:var(--amber)" />
      <ellipse cx="20" cy="25.5" rx="5.8" ry="13.3" style="fill:var(--amber-light)" />
      <ellipse cx="20" cy="27" rx="15" ry="9" fill="url(#stl-lit)" />
      <path fill="url(#stl-face)" d="M10.5 22.5l3.5-3.5 3.5 3.5-3.5 3.5zM22.5 22.5l3.5-3.5 3.5 3.5-3.5 3.5zM9.5 29q10.5 9.5 21 0-10.5 3.8-21 0z" />
    </symbol>
    <symbol id="stl-pumpkin-c" viewBox="0 0 40 40">
      <path d="M18 9.5c-.3-3.4 1-5.9 3.4-7.5 1 2.2 1.1 4.8.1 7.5z" style="fill:#5b6b2e" />
      <ellipse cx="20" cy="24" rx="15" ry="15" style="fill:var(--amber-dark)" />
      <ellipse cx="20" cy="24" rx="9.5" ry="15.5" style="fill:var(--amber)" />
      <ellipse cx="20" cy="24" rx="4.2" ry="15.8" style="fill:var(--amber-light)" />
      <ellipse cx="20" cy="26" rx="12" ry="11" fill="url(#stl-lit)" />
      <path fill="url(#stl-face)" d="M10 22l6.5-5.5.5 5.5zM23 22l.5-5.5 6.5 5.5z" />
      <ellipse cx="20" cy="30" rx="3.4" ry="4" fill="url(#stl-face)" />
    </symbol>
    <symbol id="stl-bat" viewBox="0 0 100 50">
      <path d="M50 9l-4-7-2 9c-4-2-8-2-12 1C24 4 12 4 2 12c6 2 10 8 10 15 6-3 12-1 14 5 6-2 12 0 16 6l8 6 8-6c4-6 10-8 16-6 2-6 8-8 14-5 0-7 4-13 10-15C88 4 76 4 68 12c-4-3-8-3-12-1l-2-9z" />
    </symbol>
  </svg>

  <!-- decor (desktop only): a bat flock leaving the web in the top-right corner.
       Web goes last so .sched-bat:nth-of-type(n) counts bats only. -->
  <span class="sched-decor">
    <svg class="sched-bat" aria-hidden="true"><use href="#stl-bat" /></svg>
    <svg class="sched-bat" aria-hidden="true"><use href="#stl-bat" /></svg>
    <svg class="sched-bat" aria-hidden="true"><use href="#stl-bat" /></svg>
    <svg class="sched-bat" aria-hidden="true"><use href="#stl-bat" /></svg>
    <CornerWeb class="sched-web" />
  </span>

  <div class="container">
    <SectionHead
      label="A Day at Camp"
      labelClass="sched-sec-label"
      title="What Does a Camp Day Look Like?"
    />
    <div class="sched-timeline reveal">
      <!-- paths are built in scripts/modules/schedule.js from the real pumpkin positions -->
      <svg class="stl-vine" aria-hidden="true">
        <path class="stl-vine-leaf" />
        <path class="stl-vine-line" pathLength="1" />
      </svg>
      {
        schedule.map((item, i) => (
          <div class="stl-item" data-time={item.time}>
            <div class="stl-time">{item.time}</div>
            <div class="stl-dot" style={`--tilt:${tilts[i % tilts.length]}deg`}>
              <svg aria-hidden="true"><use href={`#stl-pumpkin-${variants[i % variants.length]}`} /></svg>
            </div>
            <div class:list={['stl-card', { 'stl-accent': item.accent }]}>
              <div class="stl-icon">{item.icon}</div>
              <div class="stl-body">
                <div class="stl-body-row">
                  <span class="stl-time-badge">{item.time}</span>
                  <h4 class="stl-title">{item.title}</h4>
                </div>
                <p class="stl-desc">{item.desc}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="mob-tap-hint mob-tap-hint-sched">Tap to see details</p>
  </div>
</section>
